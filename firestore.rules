rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    //  Helper functions
    //  Trusted role comes from custom claims (request.auth.token.role),
    //  NEVER from any client-writable document.
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function tokenRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && tokenRole() == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && tokenRole() == 'teacher';
    }

    function isStaff() {
      return isAdmin() || isTeacher();
    }

    function isStudent() {
      return isSignedIn() && (tokenRole() == 'student' || tokenRole() == null);
    }

    // Teacher's assigned class IDs from custom claims.
    // Returns null if not set — the `in` check will fail (deny by default).
    function teacherClassIds() {
      return request.auth.token.teacherClassIds;
    }

    // Check if a student's classId is in the teacher's assigned classes.
    function isStudentInTeacherClass(studentClassId) {
      return isTeacher()
        && teacherClassIds() != null
        && studentClassId is string
        && studentClassId in teacherClassIds();
    }

    // Fields a student/teacher/admin may write on their own profile.
    // System / reward / authorization fields are NOT included:
    //   role, xp, level, stars, coins, badges, grade, classId, section,
    //   className, accountStatus, passwordHash, username, email,
    //   teacherClassIds, rewardsClaimed, dailyClaimed, completedMissions,
    //   missionScores, streakDays, streakHistory, lastActiveDate
    function onlySelfEditableFields(data) {
      return data.keys().hasOnly([
        'name', 'fullName', 'nickname', 'displayName',
        'avatar', 'avatarUrl', 'avatarType', 'bio', 'updatedAt',
        'settings', 'kobiCustomization', 'kobiPosition', 'mustChangePassword'
      ]);
    }

    function mustChangePasswordOnlyFalse(data) {
      return !('mustChangePassword' in data) || data.mustChangePassword == false;
    }

    function noPasswordFields(data) {
      return !('passwordHash' in data) && !('password' in data);
    }

    // No authorization-sensitive fields in self-writes.
    function noAuthFields(data) {
      return !('role' in data)
        && !('classId' in data)
        && !('grade' in data)
        && !('gradeLevel' in data)
        && !('section' in data)
        && !('className' in data)
        && !('teacherClassIds' in data)
        && !('accountStatus' in data)
        && !('rewardsClaimed' in data)
        && !('dailyClaimed' in data)
        && !('xp' in data)
        && !('level' in data)
        && !('stars' in data)
        && !('coins' in data)
        && !('badges' in data)
        && !('streakDays' in data)
        && !('streakHistory' in data)
        && !('lastActiveDate' in data)
        && !('completedMissions' in data)
        && !('missionScores' in data);
    }

    // ============================================================
    //  users/{userId}
    // ============================================================
    match /users/{userId} {
      // ---- READ ----
      // Own profile: any signed-in user.
      // Admin: reads all users.
      // Teacher: reads ONLY students in their assigned classes
      //   (verified via custom claims — NOT client-writable doc).
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || isAdmin()
        || isStudentInTeacherClass(resource.data.classId)
      );

      // ---- CREATE ----
      // Only on registration: student creates own profile doc.
      // Validates initial values to prevent inflated XP/stars/coins.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isStudent()
        && noPasswordFields(request.resource.data)
        && noAuthFields(request.resource.data)
        && request.resource.data.role is string
        && request.resource.data.role == 'student'
        && request.resource.data.username is string
        && request.resource.data.xp is int
        && request.resource.data.xp == 0
        && request.resource.data.level is int
        && request.resource.data.level == 1
        && request.resource.data.stars is int
        && request.resource.data.stars == 0
        && request.resource.data.coins is int
        && request.resource.data.coins <= 50
        && request.resource.data.grade is int
        && request.resource.data.grade >= 1
        && request.resource.data.grade <= 6;

      // ---- UPDATE (self — any role) ----
      // A user may update their own profile, but ONLY self-editable
      // fields. Role, XP, stars, coins, level, badges, grade, classId,
      // accountStatus, teacherClassIds, rewardsClaimed, dailyClaimed —
      // ALL BLOCKED. Protected-field writes go through Cloud Functions.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && onlySelfEditableFields(request.resource.data)
        && mustChangePasswordOnlyFalse(request.resource.data)
        && noPasswordFields(request.resource.data)
        && noAuthFields(request.resource.data);

      // ---- UPDATE (admin — any user) ----
      // Admin can update any user's doc. Still never allow password fields.
      allow update: if isAdmin()
        && noPasswordFields(request.resource.data);

      // ---- DELETE ----
      allow delete: if isAdmin();
    }

    // ============================================================
    //  assignments/{assignmentId}
    //  Assignments are learning content — all authenticated users
    //  can read them (filtered by grade in the UI).
    //  Only staff can create / update / delete.
    // ============================================================
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();

      allow create: if isStaff()
        && noPasswordFields(request.resource.data)
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.type is string
        && request.resource.data.createdBy is map
        && request.resource.data.createdBy.uid == request.auth.uid;

      allow update: if isStaff()
        && noPasswordFields(request.resource.data);

      allow delete: if isStaff() && (
        isAdmin() || resource.data.createdBy.uid == request.auth.uid
      );
    }

    // ============================================================
    //  classes/{classId}
    //  Teachers can read classes in their assigned list (custom claims)
    //  OR classes where their UID is in teacherIds (backward compat).
    // ============================================================
    match /classes/{classId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || (isTeacher() && (
          request.auth.uid in resource.data.teacherIds
          || (teacherClassIds() != null && classId in teacherClassIds())
        ))
        || (isStudent() && request.auth.uid in resource.data.studentIds)
      );

      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    //  Deny everything else by default
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
